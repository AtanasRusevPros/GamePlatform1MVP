{
  "name": "kids-games-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "db:migrate": "tsx apps/api/src/scripts/dbMigrate.ts",
    "db:seed": "tsx apps/api/src/scripts/dbSeed.ts",
    "db:reset": "tsx apps/api/src/scripts/dbReset.ts",
    "dev:api": "node --import tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "npm run test:unit && npm run test:integration && npm run test:web",
    "test:unit": "vitest run --config vitest.config.mts tests/unit",
    "test:integration": "vitest run --config vitest.config.mts tests/integration",
    "test:web": "vitest run --config vitest.web.config.mts tests/web",
    "test:e2e": "playwright test",
    "test:e2e:stack": "playwright test --config playwright.stack.config.ts",
    "test:full": "npm run typecheck && npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.4"
  }
}
